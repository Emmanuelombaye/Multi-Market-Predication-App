# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_prediction

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Keys (Optional - for enhanced data collection)
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
NSE_API_KEY=your_nse_api_key_here

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
DEBUG=true